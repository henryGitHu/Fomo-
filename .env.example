# Secrets go here. Copy this file to ".env" (setup.bat does it for you)
# and fill in values as each phase needs them. Never share your .env file.
# Fill in only the parts you use (see README).

# --- Phase 3: Telegram alert bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Phase 3 (optional): Discord webhook for alerts ---
DISCORD_WEBHOOK_URL=

# --- Reddit: not used (Reddit now requires manual approval) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# --- Telegram channel reading (optional, from https://my.telegram.org) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
