# Secrets go here. Copy this file to ".env" (setup.bat does it for you)
# and fill in values as each phase needs them. Never share your .env file.
# Phase 1 needs NOTHING here.

# --- Phase 3: Telegram alert bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Phase 3 (optional): Discord webhook for alerts ---
DISCORD_WEBHOOK_URL=

# --- Phase 5: Reddit API ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# --- Phase 6: Telegram channel reading (from my.telegram.org) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
