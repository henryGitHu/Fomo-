# Coloring Studio backend configuration. Copy to backend/.env and fill in what you use.
# NEVER commit a real .env. Keys entered in the AI Model Control Center UI are stored
# encrypted in the database instead and do not need to be listed here.

# --- Storage & database ---
# STUDIO_DATA_DIR=./data                       # SQLite DB, assets, exports (default: backend/data)
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/studio   # production (pip install "psycopg[binary]")
# STUDIO_STORAGE=local                          # or "s3" (pip install boto3)
# S3_BUCKET=
# S3_ENDPOINT_URL=                              # for S3-compatible stores (MinIO, R2, ...)

# --- Security ---
# STUDIO_SECRET_KEY=change-me-long-random       # encrypts stored API keys; if unset a key file is generated in the data dir
# STUDIO_API_TOKEN=                             # if set, every /api call needs "Authorization: Bearer <token>"
# STUDIO_CORS_ORIGINS=http://localhost:3000

# --- Worker ---
# STUDIO_RUN_WORKER=1                           # run the job worker inside the API process
# STUDIO_WORKER_POLL_SECONDS=0.5
# STUDIO_JOB_LEASE_SECONDS=300

# --- Research & text model (optional) ---
# STUDIO_RESEARCH_WEB=1                         # Wikipedia public API for Smart Theme Research
# STUDIO_TEXT_PROVIDER=auto                     # auto | anthropic | openai | offline
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_TEXT_MODEL=gpt-5-mini

# --- Image provider keys (alternatively enter them in the UI) ---
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# BFL_API_KEY=
# STABILITY_API_KEY=
# REPLICATE_API_TOKEN=
# FAL_KEY=

# --- Fonts embedded in PDFs (defaults to DejaVu Sans if installed) ---
# STUDIO_FONT_REGULAR=/path/to/Font-Regular.ttf
# STUDIO_FONT_BOLD=/path/to/Font-Bold.ttf

# --- Live provider tests (cost money!) ---
# STUDIO_LIVE_TESTS=1
